# 이 MariaDB 설정은 버전 11.8.3 전용입니다.
# 이전 버전과 호환은 되지 않기 때문에 그대로 사용되어서는 안됩니다.

# cd /opt/mariadb-11.8.3
# mkdir run
# chown -R root:mariadb
# chown -R mariadb:mariadb run
# mkdir -p /opt/dbstorage/tmp
# mkdir -p /opt/dbstorage/mariadb/binlogs
# mkdir -p /opt/dbstorage/mariadb/logs
# mkdir -p /opt/dbstorage/Aria
# mkdir -p /opt/dbstorage/InnoDB/ibData
# mkdir -p /opt/dbstorage/InnoDB/tmp
# mkdir -p /opt/dbstorage/InnoDB/redoLogs
# mkdir -p /opt/dbstorage/InnoDB/undoLogs
# mkdir -p /opt/dbstorage/RelayLogs
# chown -R mariadb: /opt/dbstorage

[mariadbd]
##--------------------------------------------------------------------
# MariaDB 의 기본 설정들.
##--------------------------------------------------------------------
# id 는 1 에서 2^32 -1 개 사이에 유일한 값이여 한다.
# server-id 는 복제 그룹을 구성할 경우에 중복된 값이여서는 않된다.
# 단일 시스템일 경우 기본값 1 이면 충분하다.
server_id = 1

# 서버를 구동할 시스템 사용자 지정.
user = mariadb

# 서버가 설치된 기본 디렉토리
basedir = /opt/mariadb

# 이 디렉토리의 소유권과 그룹은 user 에서 지정한 사용자와 그룹이어야 한다.
# Mariadb 시스템 데이터베이스를 위한 디렉토리이며 InnoDB 와는 다르다.
datadir = /opt/dbstorage/mariadb

# 임시 테이블과 파일을 저장하기 위한 디렉토리
# 디렉토리를 세미콜론으로 구분되는 리스트형태로 여러개를 지정할 수 있는데,
# 이렇게되면 라운드로빈 형식으로 사용하게 되는데, 여러 디스크를 이용해
# 디스크 I/O 분산을 구현할 수 있다. 
# Dynamic 설정을 할 수 없다.
tmpdir  = /opt/dbstorage/tmp

# 유닉스 시스템에서 로컬 클라이언트가 접속을 위해서 사용할 소켓 파일 이름.
# 기본값: /tmp/mysql.sock
# Dynamic 설정을 할 수 없다. 
socket  = /opt/mariadb/run/mariadb.sock

# 프로세스 ID 파일의 풀패스. 
# Dynamic 설정을 할 수 없다.
pid_file = /opt/mariadb/run/mariadb.pid

# 외부 락킹(locking), 시스템 락킹, 을 사용하지 않도록 한다. 이 설정은 오직 MyISAM 테이블에 접근할때만 영향을 준다.
# 기본값: 1
# Dynamic 설정을 할 수 없다.
skip_external_locking = 1

# 문자셋 지정.
# 기본값: utf8mb4 (>= MariaDB 11.6.0), latin1 (<= MariaDB 11.5)
# Dynamic 설정을 할 수 있다. SET GLOBAL character-set-server = utf8mb4
character_set_server = utf8mb4

# 정렬을 위한 문자셋 지정.
# 기본값: latin1_swedish_ci
# Dynamic 설정을 할 수 있다. SET GLOBAL collation_server = utf8mb4_general_ci
collation_server = utf8mb4_general_ci

# 타임존 설정.
# 초기 타임존은 'SYSTEM' 이며 이는 운영체제의 타임존과 같게 설정 된다.
# UTC 폼 형식으로 지정한다.
# Dynamic 설정을 할수 있다. SET GLOBAL time_zone = '+9:00'
default_time_zone='+9:00'

# 기본 스토리지 엔진.
# MySQL 서버가 지원하는 스토리지 엔진중에 하나를 선택할 수 있다.
# 서버가 지원하는 스토리지 엔진은 'SHOW ENGINES' 명령어를 이용해 확인 가능하다.
# 기본값: InnoDB
# Dynamic 설정할 수 있다. SET GLOBAL default_storage_engine = InnoDB
default_storage_engine = InnoDB

# 트랜잭션 레벨을 지정.
# READ UNCOMMITTED, READ COMMITTED, REPEATABLE READ, SERIALIZABLE 의 트랜잭션 레벨을 지원한다.
# 기본값: REPEATABLE-READ 
# 범위: READ-UNCOMMITTED, READ-COMMITTED, REPEATABLE-READ, SERIALIZABLE
# Dynamic 설정을 할 수 있다. SET GLOBAL transaction_isolation = 'READ-COMMITTED'
transaction_isolation = REPEATABLE-READ

##--------------------------------------------------------------------
# Network 설정.
##--------------------------------------------------------------------
# 서버 포트 지정.
port = 3306

# 서버에 접속한 클라이언트 확인을 위해서 IP를 가지고 클라이언트의 도메인을 찾는 것을 방지한다.
# 이것을 사용하면 서버에 접속가능한 클라이언트를 정의할때에 Host 필드에 도메인을 사용하면 않되며
# IP만 사용해야 한다. 대신 클라이언트의 도메인을 찾는 작업이 없기 때문에 성능상에 이점이 있다.
skip_name_resolve = ON

# 클라이언트 연결에 서버가 쓰레드를 어떻게 핸들링할지를 결정한다.
# 기본값: one-thread-per-connection (non-Windows), pool-of-threads (Windows)
# Dynamic 설정할 수 없다.
thread_handling = pool-of-threads

# thread pool 에 thread group 의 개수로 얼마나 많은 SQL 을 동시에 실행할 수 있는지를 결정한다.
# 기본값: Based on the number of processors
# 범위: 1 ~ 128
# Dynamic 설정할 수 있다. SET GLOBAL thread_pool_size = 1 
thread_pool_size = 2

# thread pool 에 최대 쓰레드 개수. 이값이 한번 초대치에 도달하면, 새로운 쓰레드는 생성되지 않는다.
# 기본값: 65536
# Dynamic 설정할 수 있다. SET GLOBAL thread_pool_max_threads = 65536
thread_pool_max_threads = 65536

# idle worker 쓰레드가 종료되기 전에 시간(초)
# 기본값: 60
# Dynamic 설정할 수 있다. SET GLOBAL thread_pool_idle_timeout = 60
thread_pool_idle_timeout = 60

# 최대 동시 접속 연결을 지정. 무턱대고 크게 잡을게 아니라 적절하게 잡아야 한다.
# 이 값을 초과하면 "Too many connections error" 메시지를 보여준다.
# 최대 유효 값은 open_files_limit의 유효 값에서 810을 뺀 값과 max_connections에 실제로 설정된 값 중 더 작은 값이 된다.
# systemd 로 운영되는 mariadb 의 경우에는 systemd's 기본값 TasksMax (대략 4915/service) 로 인해서 max_connections 값을 제한한다.
# 이를 피하기 위해서 다음과 같이 설정해줄 필요가 있다.
# [Service]
# TasksMax=infinity
# 기본값: 151
# 범위: 10 ~ 10000
# Dynamic 설정을 할수 있다. SET GLOBAL max_connections = 151
max_connections = 151

# 서버에 접속하는 사용자 계정별 최대 동시접속 수. 기본값은 0(Unlimited) 이다.
# 이 값을 -1로 설정하면 SUPER 권한이 없는 사용자 또는 MariaDB 10.5.2부터는 CONNECTION ADMIN 권한이 없는 사용자가 서버에 접속하는 것을 차단한다.
# 기본값: 0
# 범위: -1 ~ 4294967295
# 0, -1 을 제외한 Dynamic 설정을 할 수 있다. SET GLOBAL,SESSION max_user_connections = 1024
max_user_connections = 0

# MariaDB 서버에 접속한 클라이언트들은 다양한 에러를 발생시킨다. 서버는 이러한 클라이언트별 오류 갯수를 카운팅해 놓는데,
# 만일 클라이언트가 일정한 카운팅을 넘어서면 서버는 클라이언트의 접속을 차단한다.
# 클라이언트가 발생시킬 수 있는 에러의 한계치를 조정하기 위한 설정이다. 
# 이 카운터에 도달하면 "Host [client] is blocked because of many connection errors" 에러를 발생시킨다.
# 차단을 해제하기 위해서는 FLUSH HOSTS 명령문이나 mariadb-admin flush-hosts 를 이용해 host cache 를 플러시하면 된다.
# performance_schema.host_cache 테이블은 현재 호스트에 상태를 가지고 있다. 
# 기본값: 100
# 범위: 1 ~ 4294967295
# Dynamic 설정을 할수 있다. SET GLOBAL max_connect_errors = 1000000
max_connect_errors = 1000000

# 비대화형(noninteractive) 연결을 닫기 전에 연결이 활성화(active) 되기 위해 기다리는 시간(초).
# 웹에 붙여서 사용할 경우에 대부분의 30초 내외로 웹서버의 커넥션 타임이 정해져 있기 때문에 기본값은 매우 큰 값이라고 할 수 있다.
# 기본값: 28800 seconds (8시간)
# 범위: 1 ~ 31536000
# Dynamic 설정을 할수 있다. SET GLOBAL,SESSION wait_timeout = 600
wait_timeout = 600

# 대화형(interactive) 연결에서 연결을 닫기 전에 활성화 되기 위해 기다리는 시간(초)
# 대화형(interactive) 연결은 mysql_real_connect() 함수에 CLIENT_INTERACTIVE 옵션을 사용한 연결이다.
# 기본값: 28800 seconds (8시간)
# 범위: 1 ~ 31536000
# Dynamic 설정을 할수 있다. SET GLOBAL interactive_timeout = 600
interactive_timeout = 600

# 'Bad handshake'로 응답하기전 연결패킷을 기달리는 시간.
# "Lost connection to MySQL server at 'XXX', system error: errno" 메시지가 자주 보인다면 이 값을 증가시켜줄 필요가 있다.
# 기본값: 10 seconds
# 범위: 2 ~ 31536000
# Dynamic 설정을 할수 있다. SET GLOBAL connect_timeout = 10
connect_timeout = 10

# 클라이언트에서 서버로 보내는 쿼리는 단 한개의 패킷으로 처리된다. 만일 서버로 보내는 쿼리의 크기가 이 값보다 작다면 늘려줘야 한다.
# 특히 테이블 컬럼에 BLOB 타입을 사용할 경우, 그림같은 바이너리 값, 이 값을 증가시켜줄 필요가 있다.
# 현재 max 값인 1G로 설정하여 최대한 제한이 없도록 한다.
# 패킷 메시지 버퍼는 처음에 net_buffer_length 로 초기화 되고 필요에 의해 max_allowd_packet 사이즈(bytes) 까지 늘어나게 된다. (large packet 이 들어오기 전까지는 작게 할당됨)
# [mysqld] 이외에도 [client] 의 설정도 동일하게 늘려줘야 한다. 필요하다면 [mysqldump] 에도 늘려준다.
# 기본값: 67108864 byte
# 범위: 1024 (1MB)  ~ 1073741824 (1GB)
# Dynamic 설정을 할수 있다. SET GLOBAL,SESSION max_allowed_packet = 1048576
max_allowed_packet = 1073741824

##--------------------------------------------------------------------
# Replication
##--------------------------------------------------------------------

# master 의 binlog 에서 I/O 리플리케이션 쓰레드가 어디에 있는지를 마스터가 기억하는 파일 및 경로
master_info_file = /opt/dbstorage/mariadb/binlogs/master.info

# Primary 서버를 위해 리플리케이션 도메인 새로운 GTID 를 기록할지 결정하는데 사용한다.
# 이 값은 SUPER 권한을 가진 사용자에 의해서 Session 레벨에서도 설정할 수 있다.
# mariadb-binlog 에서 GTID 이벤트의 도메인 ID 를 보존하기 위해서 사용된다.
# 기본값: 0
# 범위: 0 ~ 4294967295
# Dynamic 설정할 수 있다. SET GLOBAL, SESSION gtid_domain_id = 1
gtid_domain_id = 1

# 모든 binlog 파일에 GTID 인덱스를 생성하도록 한다. 
# GTID 인덱스는 binlog 에서 GTID 를 빠르게 찾도록 해준다.
# 기본값: ON
# Dynamic 설정할 수 있다. SET GLOBAL binlog_gtid_index = ON
binlog_gtid_index = ON

# binlog GTID 인덱스를 위한 페이지 크기
# 기본값: 4096
# 범위: 64 ~ 16777216
# Dynamic 설정할 수 있다. SET GLOBAL binlog_gtid_index_page_size = 4096 
binlog_gtid_index_page_size= 4096

#--------------------- Replica 에서만 설정 --------------------------------#

# relay 로그를 위한 파일이름.
# Dynamic 설정할 수 없다.
#relay_log = /opt/dbstorage/RelayLogs/localhost-01-relay

# relay log 인덱스 파일이 이름.
# 이 파일은 마지막 relay log의 목록을 유지한다.
# Dynamic 설정할 수 없다.
#relay_log_index = /opt/dbstorage/RelayLogs/localhost-01-relay.index

# CHANGE MASTER 문에서 사용되는 RELAY_LOG_FILE 및 RELAY_LOG_POS 옵션이 기록되는 파일의 이름과 위치.
# Dynamic 설정할 수 없다.
#relay_log_info_file = /opt/dbstorage/RelayLogs/relay-log.info

# 1 로 설정하면 relay 로그가 더 이상 필요하지 않으면 즉각 퍼지한다.
# 기본값: ON
# Dynamic 설정할 수 있다. SET GLOBAL relay_log_purge = 1
#relay_log_purge = 1

# 지정된 이름과 일치하는 데이터베이스에 영향을 주는 명령문과 트랜잭션을 Replica에 적용하도록 설정할 수 있게 해준다.
# statement-based logging 하는 크로스 데이터베이스 업데이트에는 작동하지 않는다.
# 여러 값을 콤마(,) 이용해 지정하면 된다.
# 지정하지 않으면 모든 데이터베이스에 적용된다.
# Dynamic 설정할 수 있다. SET GLOBAL replicate_do_db = a
#replicate_do_db = 

# 지정된 이름과 일치하는 데이터베이스에 영향을 주는 명령문과 트랜잭션을 Replica에 적용하지 않도록 한다.
# statement-based logging 하는 크로스 데이터베이스 업데이트에는 작동하지 않는다.
# 여러 값을 콤마(,) 이용해 지정하면 된다.
# Dynamic 설정할 수 있다. SET GLOBAL replicate_ignore_db = a
#replicate_ignore_db = 

# 지정된 이름과 일치하는 테이블에 영향을 주는 명령문과 트랜잭션을 Replica에 적용하도록 설정할 수 있게 해준다.
# 테이블 이름의 포맷은 dbname.tablename 여야 한다.
# statement-based logging 하는 크로스 데이터베이스 업데이트에는 작동하지 않는다.
# 여러 값을 콤마(,) 이용해 지정하면 된다.
# 지정하지 않으면 모든 테이블에 적용된다.
# Dynamic 설정할 수 있다. SET GLOBAL replicate_do_table = spring.account
#replicate_do_table = 

# 지정된 이름과 Wild pattern과 일치하는 테이블에 영향을 주는 명령문과 트랜잭션을 Replica에 적용하도록 설정할 수 있게 해준다.
# Wild pattern 테이블은 LIKE 명령문과 동일하다.
# statement-based logging 하는 크로스 데이터베이스 업데이트에는 작동하지 않는다.
# 여러 값을 콤마(,) 이용해 지정하면 된다.
# 지정하지 않으면 모든 테이블에 적용된다.
# Dynamic 설정할 수 있다. SET GLOBAL replicate_wild_do_table = 'spring.account%'
#replicate_wild_do_table =

# 지정된 이름과 일치하는 테이블에 영향을 주는 명령문과 트랜잭션을 Replica에 적용하지 않도록 한다.
# 테이블 이름의 포맷은 dbname.tablename 여야 한다.
# statement-based logging 하는 크로스 데이터베이스 업데이트에는 작동하지 않는다.
# 여러 값을 콤마(,) 이용해 지정하면 된다.
# Dynamic 설정할 수 있다. SET GLOBAL replicate_ignore_table = spring.account
#replicate_ignore_table = 

# 지정된 이름과 Wild pattern과 일치하는 테이블에 영향을 주는 명령문과 트랜잭션을 Replica에 적용하지 않도록 한다.
# Wild pattern 테이블은 LIKE 명령문과 동일하다.
# statement-based logging 하는 크로스 데이터베이스 업데이트에는 작동하지 않는다.
# 여러 값을 콤마(,) 이용해 지정하면 된다.
# Dynamic 설정할 수 있다. SET GLOBAL replicate_wild_ignore_table = 'spring.account%'
#replicate_wild_ignore_table = 

# 이 옵션은 복제서버에서 데이터베이스 이름을 바꾸도록 설정해 준다.
# 포맷은 primary_database->replica_database 이다.
# 만약 복제서버에서 기본 데이터베이스가 primary_database 인 binary log 이벤트를 감지하면,
# statement-based logging 하는 크로스 데이터베이스 업데이트에는 작동하지 않는다.
# 이 옵션은 테이블과 관련된 명령문에만 영향을 준다.
# 데이터베이스 관련한 CREATE DATABASE, ALTER DATABASE, DROP DATABASE 와 같은 명령문에는 적용되지 않는다.
# Dynamic 설정할 수 있다. SET GLOBAL replicate_rewrite_db =  primary_database->replica_database
#replicate_rewrite_db = 

# 기본값 0 은 Primary 서버로부터 전달받은 복제본을 업데이트할때, Replica 서버에 binary 로그에 기록하지 않는다.
# 1 은 Binary 로그에 기록하도록 한다. 
# 이 기능이 효과를 발휘하려면 Replica 서버의 binary 로그가 활성화 되어 있어야 한다.
# 데이시 체인 복제를 위해서는 반드시 1로 설정해야 한다.
# 기본값: OFF
# Dynamic 설정할 수 없다.
#log_slave_updates = OFF

##--------------------------------------------------------------------
# Bin Log and Replication
##--------------------------------------------------------------------

# 얼마나 자주 binary log 를 디스크로 동기화하는지를 제어한다.
# sync_binlog = 0: MariaDB 서버에 의한 binary log 를 디스크로 동기화를 비활성화. 대신에 MariaDB 서버는
# 운영시스템에 의존해 binary log 를 디스크로 플러쉬한다. 이 설정은 최고의 성능을 제공하지만
# 서버 크래쉬나 정전에 대해 커밋된 트랜잭션이 플러쉬 되지 않아 데이터 손실이 될 수 있다.
# sync_binlog = 1: 트랜잭션이 커밋되는 동안 binary log 를 디스크로 동기화하도록 한다. 
# 이 설정은 최고로 안전하지만 디스크 쓰기를 증가시켜 성능에 부정적인 영향을 줄 수 있다. 
# 정전이나 운영 시스템 크래쉬에, binary log 로 누락되는 트랙잭션은 prepared state 뿐이다. 
# 이것은 binary log 에 잃어버리는 트랜잭션이 없도록 보장하기 위해 롤백을 위한 자동 리커버리 루틴하도록 한다.
# sync_binlog = N: binary log 는 N binary log commit 그룹이 수집된 후 디스크로 동기화 된다.
# 이 값을 높이면 성능을 개선하지만 데이터 손실 위험도 증가 한다.
# 트랜잭션을 사용하는 InnoDB 기반의 복제 환경에서 가능한 최고의 내구성과 일관성을 확보하려면
# sync_binlog=1, innodb_flush_log_at_trx_commit=1 로 해야 한다.
# 기본값: 0
# 범위: 0 ~ 4294967295
# Dynamic 설정을 할수 있다. SET GLOBAL sync_binlog = 1
sync_binlog = 1

# replication 이 row-based, statement-based 혹은 mixed 어떤걸 사용할지 결정한다.
# Statement-based 는 MariaDB 10.2.3 까지 기본값이였다. 이미 Replication 을 운영중에
# binary log 포맷을 바꾸는 것은 조심해야 한다.
# MariaDB 10.0.22부터는 복제 서버(replica)가 기본 서버(primary)로부터 받은 이벤트를 바이너리 로그 형식에 관계없이 적용된다. 
# binlog_format 설정은 일반적인(복제되지 않은) 업데이트에만 적용됩니다."
# 기본값: MIXED
# 범위: MIXED, STATEMENT, ROW
# Dynamic 설정을 할수 있다.SET GLOBAL,SESSION binglog_format = ROW
binlog_format = ROW

# Binary logging 활성화.
# --log-bin 커맨드를 이용할 경우에는 파일경로와함께 파일명을 주어야 하며
# 커맨드를 이용하지 않을 경우에 log_bin 은 활성화/비활성 용도로 사용된다.
# 역: 문서의 내용과 맞지 않게 패스와 파일명을 함께 지정해도 된다.
# 기본값: OFF
# 범위: ON, OFF
# Dynamic 설정을 할 수 없다.
log_bin = /opt/dbstorage/mariadb/binlogs/localhost-01-bin

# binlog_expire_logs_seconds 는 이렇게 생성된 파일들에 보관 기간을 설정한다. 
# 만일 0 이 아니라면 binary logs 는 binlog_expire_logs_seconds 초 이후에 퍼지될 것이다.
# 바이너리 로그 파일은 자동으로 삭제 되는데,
# 바이너리 로그가 로테이션 될때나  서버가 시작될때에 삭제 된다.
# 만일 수동으로 삭제할려면, PURGE BINARY LOGS 문을 사용하라.
# MariaDB 10.6.1 부터 binlog_expire_logs_seconds, expire_logs_days 는 Alias 형태인데, 한쪽이 변경되면 자동으로 다른쪽에 반영된다.
# 기본값: 0 seconds
# 범위: 0 ~ 8553600
# Dynamic 설정할 수 있다. SET GLOBAL binlog_expire_logs_seconds = 2592000
binlog_expire_logs_seconds = 2592000

# Binary log 파일 이름을 정한다.
# 파일의 경로와 함께 파일명을 지정하면 된다.
# 최대 변수 길이는 256 이며 기본 위치는 data 디렉토리다.
# 범위: filename
# Dynamic 설정을 할수 없다.
#log_bin_basename = /opt/dbstorage/mariadb/binlogs/localhost-01-bin

# binary log 가 활성화된 경우
# 이 설정은 하나의 연결마다 트랜잭션중에 바이너리 로그 변경의 기록을 들고있는 캐쉬의 크기를 결정한다. 
# 기본값: 32768 bytes
# 범위: 4096 ~ 18446744073709547520
# Dynamic 설정 할 수 있다. SET GLOBAL binlog_cache_size = 32768
binlog_cache_size = 32768

# binary log 에 쓸때 현지 로그 파일 크가기 이 값보다 크게되면 서버는 binary log 를 로테이션 한다.
# (현재 로그 파일을 닫고 다음 로그파일을 오픈한다)
# 하나의 트랜잭션은 같은 binary log 에 항상 저장되는데, 서버는 로테이션 되기전에 열려있는 트랜잭션이 완료될때까지 기다린다.
# max_relay_log_size 가 0 이면, relay logs 크기에 이값이 적용된다.
# 최대 바이너리 로그 파일 크기.
# 기본값: 1073741824 bytes
# 범위: 4096 ~ 1073741824
# Dyanmic 설정할 수 있다. SET GLOBAL max_binlog_size = 1073741824
max_binlog_size = 1073741824

##--------------------------------------------------------------------
# Logging
##--------------------------------------------------------------------

# 제너럴 쿼리 로그(general query log)와 슬로우 쿼리 로그(slow query log)의 출력 목적지를 결정한다.
# 이 옵션은 다른 어떤 옵션들을 덮습니다. 이 값이 NONE 이라면 다른 옵션에서 로그기록을 설정했어도 로그는 기록되지 않습니다.
# 기본값: FILE
# 범위: TABLE, FILE, NONE
# Dynamic 설정을 할수 있다. SET GLOBAL log_output = FILE
log_output = FILE

# 추가적인 warnings 을 기록할지를 결정.
# 0 이면 추가적인 warning 을 기록하지 않는다. 다만, 모든 warning 을 차단하지 않는다.
# 여전히 core warning 은 항상 error log 에 기록된다.
# 이 설정은 MySQL 에 log_error_verbosity 에 대응된다.
# 기본값: 2
# 범위: 1 ~ 4294967295
# Dynamic 설정을 할수 있다. SET GLOBAL,SESSION log_warnings = 2
log_warnings = 2

# 에러나 시작 메시지 로그 파일을 지정.  파일명을 지정하지 않을 경우 host_name.err 를 사용하며 확장자를 지정하지 않으면 .err 를 붙인다.
# 기본값은 없으며 Dynamic 설정을 할 수 없다.
log_error = /opt/dbstorage/mariadb/logs/mariadb_error.log

# 제너럴 쿼리 로그(general query log) 의 사용 유무를 결정. log_output 값이 NONE 이라면 이 값은 무시됩니다.
# 기본값: 0
# Dynamic 설정을 할수 있다. SET GLOBAL general_log = OFF
general_log = 0

# general query log 파일 이름 지정.
# Dynamic 설정을 할 수 있다. SET GLOBAL general_log_file = /opt/dbstorage/mariadb/logs/general_query_all.log
general_log_file = /opt/dbstorage/mariadb/logs/general_query_all.log

# 슬로우 쿼리 로그를 기록할지 말지를 결정. log_output 값이 NONE 이라면 이 값은 무시됩니다.
# 기본값: 0
# Dynamic 설정을 할수 있다. SET GLOBAL log_slow_query = OFF
log_slow_query = 0

# 슬로우 쿼리를 기록할 시간을 지정. 이 시간보다 크면 기록된다.
# 기본값: 10.000000 seconds
# 범위: 0 ~ 31536000
# Dynamic 설정을 할수 있다. SET GLOBAL log_slow_query_time = 10
log_slow_query_time = 2

# 슬루우 쿼리를 기록할 파일 이름.
# Dynamic 설정을 할 수 있다. SET GLOAL log_slow_query_file = /opt/dbstorage/mariadb/logs/slow_query.log
log_slow_query_file = /opt/dbstorage/mariadb/logs/slow_query.log

# 관리명령에 대해서도 slow query 를 남길지 결정.
# 관리명령은 ALTER TABLE, ANALYZE TABLE, CHECK TABLE, CREATE INDEX, DROP INDEX, OPTIMIZE TABLE, and REPAIR TABLE.
# log_slow_filter=admin 을 사용해 지정할 수 있다.
# 기본값: OFF 
# Dynamic 설정을 할 수 있다. SET GLOBAL log_slow_admin_statements = ON
log_slow_admin_statements = ON

# 인덱스를 사용하지 않는 쿼리나 인덱스에 레코드 제한없는 인덱스 풀 스캔을 실행하는 쿼리를 slow query log 에 기록한다.
# log_slow_filter=not_using_index 를 사용 지정할 수 있다.
# 기본값: OFF
# Dynamic 설정을 할수 있다. SET GLOBAL log_queries_not_using_indexes = OFF
log_queries_not_using_indexes = OFF 

##--------------------------------------------------------------------
# 캐쉬와 메모리
##--------------------------------------------------------------------
# 재사용을 위한 쓰레드를 서버가 얼마나 가지고 있어야 하는 지정하는 것.
# 클라이언트가 접속요청을 하면 서버는 이를 처리할 프로세스로 쓰레드를 생성한다. 접속이 완료되면 모든 작업들도 이 쓰레드를 통해서 이루어진다.
# 만일 클라이언트가 모든 작업을 끝마치고 접속을 해제하면 쓰레드는 파기되어야 하지만 재사용을 하기 위해서 이를 보관해 둔다.
# 동시접속자가 많을수록 이값을 늘려줄 필요가 있지만, 메모리 사용량도 증가할 수 있다.
# 만약 thread_pool 를 활성화 했다면, 이 설정은 무시된다. 만약 thread_cache_size 가 max_connection 보다 크다면
# thread_cache_size 는 max_connections 값으로 지정된다.
# 기본값: 256. 
# Dynamic 설정을 할수 있다. SET GLOBAL thread_cache_size = 256
thread_cache_size = 256

# 한 테이블 캐쉬 인스턴스에 오픈 테이블 캐쉬된 최대 개수.
# 이 값의 증가는 file descriptor 증가를 필요로 한다.
# 기본값: 2000.
# 범위: 1 ~ 1048576
# Dynamic 설정을 할수 있다. SET GLOBAL table_open_cache = 400
table_open_cache = 400

# 사용자 생성 Memory 테이블에 대한 최대 크기(bytes).
# 서버가 사용중일때, 이값을 지정하면 재성성하거나 altered 하지 않는한 이미 있는 테이블에는 아무런 영향을 주지 않는다. 
# 최대 크기에 도달한 상태에서 새로운 데이터를 추가하면 "table.. is full" 에러를 낸다. 
# 기본값: 16777216 bytes
# 범위: 16384 ~ 4294966272
# Dynamic 설정할 수 있다. SET GLOBAL max_heap_table_size = 16777216
max_heap_table_size = 8388608

# MEMORY tables 이 아닌 메모리에 임시 테이블의 최대 크기. 
# 만약 max_heap_table_size 가 더 작다면 더 작은 값이 적용된다.
# Created_tmp_disk_tables 과 Created_tmp_tables 와 같은 통계값을 비교해 전체 임시테이블중에
# 디스크로 변환되는 양을 보고 이 값을 증가시킬 필요를 결정할 수 있다.
# 복잡한 GROUP BY 쿼리는 가끔 제한을 초과하는 원인이 된다.
# 기본값: 16777216 bytes
# 범위: 0 ~ 4294967295
# Dynamic 설정을 할 수 있다. SET GLOBAL,SESSION tmp_table_size = 16777216
tmp_table_size = 16777216

# 각 섹션에서 정렬을 위해서 할당되는 버퍼의 크기. 이 값은 어떤 스토리지 엔진에서도 특정되지 않는다.
# SHOW GLOBAL STAUS 에서 초당 'Sort_merge_passes' 값이 많이 보인다면 쿼리를 개선하거나 인덱싱을 개선하는 대신에 
# ORDER BY 나 GROUP BY 연산 속도를 높이기 위해 이 값을 늘려보는 것도 좋다.
# 기본값: 262144 bytes
# 범위: 32768 ~ 18446744073709551615
# Dynamic 설정을 할수 있다. SET GLOBAL,SESSION sort_buffer_size = 262144
sort_buffer_size = 262144

# MyISAM,Aria 그리고 MERGE 테이블에 대해서 각 쓰레드가 sequentail scan 을 할때에 이 값의 크기만큼 버퍼를 각 할당한다.
# sequentail scan 이 자주 발생하면 이 값을 증가시킬 필요가 있다.
# 4Kb 의 배수로 설정해야 한다. 4Kb 의 배수가 아닌 경우, 가장 가까운 작은 배수로 반올림 된다. 
# ORDER BY 절에서 인덱스를 temporary file(not temporary table)에 캐싱할 때, nested queries의 결과를 캐싱할 때, 
# 파티션에 대량 삽입할 때, 그리고 MEMORY 테이블의 메모리 블록 크기를 결정할 때에도 사용된다.
# 기본값: 131072 bytes
# 범위: 8192 ~ 2147479552
# Dynamic 설정을 할수 있다. SET GLOBAL,SESSION read_buffer_size = 16777216
read_buffer_size = 131072

# 키 정렬 후 MyISAM 테이블에서 정렬된 순서로 행을 읽을 때 사용되는 버퍼의 크기(bytes). 
# 값이 클수록 ORDER BY 성능이 향상되지만, 과도한 메모리 사용을 피하기 위해 필요한 경우 세션 단위로 크기를 조절해야 한다.
# 기본값: 262144 bytes
# 범위: 8200 ~ 2147483647
# Dynamic 설정을 할수 있다. SET GLOBAL,SESSION read_rnd_buffer_size = 262144
read_rnd_buffer_size = 262144

# 인덱스를 사용하지 않고, 풀 테이블 스캔을 사용 쿼리를 사용되는 버퍼의 최소크기(bytes)
# 인덱스 추가가 불가능할때 풀 조인을 좀 더 빠르게 하기 위해서 이 값을 늘리면 된다.
# 단, 항상 최소값을 할당하기 때문에 메모리 사용에 유의해야 한다.
# 기본값: 262144 bytes
# 범위: 128 ~ 18446744073709547520
# Dynamic 설정을 할수 있다. SET GLOBAL,SESSION join_buffer_size = 131072
join_buffer_size = 131072

##--------------------------------------------------------------------
# Aria
##--------------------------------------------------------------------

# 트랜잭셔널 로그를 저장할 디렉토리 경로.
# 기본값: datadir
# Dynamic 설정을 할 수 없다.
aria_log_dir_path = /opt/dbstorage/Aria

# Aria 테이블에서 데이터 블럭과 인덱스에서 사용할 버퍼 크기.
# 이 값은 명시적 Aria 테이블, system 테이블, 임시 테이블에 적용된다.
# 기본값: 134217728 bytes (128MB)
# 범위: 131072 이상
# Dynamic 설정을 할 수 없다.
aria_pagecache_buffer_size = 134217728 

# CREATE INDEX 나 ALTER TABLE 로 인덱스를 생성할때나
# REPAIRE 를 사용해 인덱스를 정렬할때 할당되는 버퍼.
# 기본값: 268434432
# Dynamic 설정할 수 있다. SET GLOBAL,SESSION aria_sort_buffer_size = 268434432
aria_sort_buffer_size = 268434432

# 로그 파일이 커지고 새로운 파일을 생성한 이후에 디렉토리 동기화를 제어.
# 기본값: NEWFILE
# 범위: NEWFILE, NEVER, ALWAYS
# Dynamic 설정할 수 있다. SET GLOBAL aria_sync_log_dir = NEWFILE
aria_sync_log_dir = NEWFILE

# 임시 테이블에 대해 Aria 스토리지 엔진을 사용할지를 나타내는 읽기 전용 변수.
# 이게 On 이면, Aria 스토리지 엔진을 사용한다.
# 만약 OFF 면, MaraiDB 는 디스크 기반 임시 테이블은 MyISAM 를 사용한다.
# 때로는 이 변수의 설정과 관계없이 임시 테이블에 MEMORY 스토리지 엔진이 사용된다.
# 기본값: ON
# Dynamic 설정할 수 없다.
#aria_used_for_temp_tables = 1

##--------------------------------------------------------------------
# MyISAM
##--------------------------------------------------------------------

# MyISAM 테이블에서 사용되는 인덱스 블록을 위한 버퍼 크기이며, 모든 스레드가 공유한다.
# 기본값: 134217728 bytes
# 범위: 8 upwards (upper limit determined by operating system per process limit)
# Dynamic 설정을 할수 있다. SET GLOBAL key_buffer_size = 131072
key_buffer_size = 8388608

# bulk insert 는 INSERT ... SELECT, INSERT ... VALUES (..),(..),... , LOAD_DATA_INFILE 등을 말한다.
# 이때 사용되는 버퍼를 사용해서 속도를 높일 수 있다.
# 기본값: 8388608 bytes
# 범위: 0 ~ 1152921504606846975
# Dynamic 설정을 할수 있다. SET GLOBAL bulk_insert_buffer_size = 131072
bulk_insert_buffer_size = 8388608

# CREATE INDEX, ALTE TABLE 등으로 인덱스를 생성하거나 REPAIR_TABLE 하는데에 인덱스 정렬이 필요할때에 필요한 버퍼.
# 기본값: 134216704 bytes
# 범위: 4096 ~ 18446744073709551615
# Dynamic 설정을 할수 있다. SET GLOBAL,SESSION myisam_sort_buffer_size = 131072
myisam_sort_buffer_size = 2097152

# REPAIR_TABLE, ALTER_TABLE, LOAD_DATA_INFILE 중에 MyISAM 인덱스를 재생성해야 할 경우에 허용할 임시 파일 최대값.
# 기본값: 9223372036854775807 bytes
# Dynamic 설정을 할수 있다. SET GLOBAL myisam_max_sort_file_size = 131072
myisam_max_sort_file_size = 2147483648

# 예기치 못한 서버의 중단으로 서버가 재시작되었을때에 리커버리를 할지 결정하는 옵션.
# OFF, DEFAULT, BACKUP, BACKUP_ALL, FORCE, QUICK 값을 콤마(,)로 나열해서 사용할 수 있다.
# 값을 주지 않으면 DEFAULT, 빈값 "" 면 OFF 다. 
# 기본값: BACKUP,QUICK (>= MariaDB 10.2.4)
# Dynamic 설정을 할 수 없다.
myisam_recover_options = DEFAULT

##--------------------------------------------------------------------
# InnoDB behavior
##--------------------------------------------------------------------

# MariaDB 10.5 이전까지는 이것이 단순히 InnoDB 읽기 작업을 위한 I/O 스레드 수를 의미했지만, 
# MariaDB 10.5부터는 InnoDB background thread pool 의 asynchronous I/O 기능이 기존의 InnoDB I/O thread를 대체한다.
# 이값은 Background Thread Pool 의 의해서 완료되어질 수 있게 동시 비동기 I/O 읽기 요청의 최대 숫자를 결정하기 위해 256 를 곱한다.
# 따라서 기본값은 4*256 = 1024 동시 비동기 읽기 요청이다.
# 리눅스에 aio-max-nr 시스템 제한을 체크해야 한다.
# 기본값: 4
# 범위: 1 ~ 64
# Dynamic: Yes (>= MariaDB 10.11), No (<= MariaDB 10.10)
# SET GLOBAL innodb_read_io_threads = 4
innodb_read_io_threads = 4

# MariaDB 10.5 이전까지는 이것이 단순히 InnoDB 읽기 작업을 위한 I/O 스레드 수를 의미했지만, 
# MariaDB 10.5부터는 InnoDB background thread pool 의 asynchronous I/O 기능이 기존의 InnoDB I/O thread를 대체한다.
# 이값은 Background Thread Pool 의 의해서 완료되어질 수 있게 동시 비동기 I/O 읽기 요청의 최대 숫자를 결정하기 위해 256 를 곱한다.
# 따라서 기본값은 4*256 = 1024 동시 비동기 읽기 요청이다.
# 리눅스에 aio-max-nr 시스템 제한을 체크해야 한다.
# InnoDB의 백그라운드 쓰레드인 I/O 쓰레드의 쓰기 쓰레드의 갯수를 정합니다.
# 기본값: 4
# 범위: 1 ~ 64
# Dynamic: Yes (>= MariaDB 10.11), No (<= MariaDB 10.10)
# SET GLOBAL innodb_write_io_threads = 4
innodb_write_io_threads = 4

# InnoDB purge 연산에 할당된 백그라운드 쓰레드 개수.
# 적어도 1개의 백그라운드 쓰레드는 항상 사용한다. 
# 이 값을 높이면 다중 테이블에 DML 연산의 효율을 높일 수 있다.
# 기본값: 4
# 범위: 1 ~ 32
# Dynamic 설정을 할 수 없다.
innodb_purge_threads = 1

# 만약 1 로 지정하면 "SHOW TABLE STATUS", "SHOW INDEX" 과 같은 메타데이터 명령문을 실행할때 또는
# "INFORMATION_SCHEMA.TABLES" 나 "INFORMATION_SCHEMA.STATISTICS" 에 접근할때
# XtraDB/InnoDB 는 통계를 업데이트 한다.
# 만약 0 으로 지정하면 통계가 업데이트 되지 않기 때문에 큰 테이블이나 인덱스 스키마에 대한 접근 속도를 높일 수도 있다.
# 이 변수를 Enable 하면 쿼리 플랜을 개선하는 도움을 줍니다.
# 기본값: OFF
# Dynamic 설정을 할수 있다. SET GLOBAL innodb_stats_on_metadata = OFF
innodb_stats_on_metadata = ON

# ANALYZE TABLE 은 인덱스 통계를 생성하며 이 세팅은 서버가 재시작될때에 좀 더 빠르게 
# 재계산이 요구될때에 디스크에 저장할지 말지를 결정한다.
# 이 정보는 각 테이블에 저장되는데, 테이블 생성/수정시에 STATS_PERSISTENT 함께 지정할 수 있다.
# 기본값: ON
# Dynamic 설정을 할 수 있다. SET GLOBAL innodb_stats_persistent = ON
innodb_stats_persistent = ON

# 인덱스된 컬럼의 통계나 카디넬러티를 측정할때 샘플된 인덱스 페이지의 수.
# 이 값을 증가시면, 인덱스 통계를 정확도를 향상시키지만 ANALYZE TABLE 실행할때
# 더 많은 I/O 자원을 사용한다.
# 기본값: 20
# Dynamic 설정을 할 수 있다. SET GLOBAL innodb_stats_persistent_sample_pages = 20 
innodb_stats_persistent_sample_pages = 20

# 이 변수는 transient 통계를 위한 샘플의 페이지수를 적용할지를 결정한다.
# 어떻게 하는지는 innodb_stats_transient_sample_pages 사용한다.
# 기본값: ON
# Dynamic 설정을 할 수 있다. SET GLOBAL innodb_stats_traditional = ON
innodb_stats_traditional = OFF

# 샘플을 위한 인덱스 페이지 수를 결정함으로써 인덱스 분포 통계에 대한 제어를 제공.
# 높은 값은 더 많은 Disk I/O 를 만들지만, 특히나 큰 테이블일수록, 좀 더 정확한 통계를 만들며
# 이로 인해서 쿼리 옵티마이저를 좀 더 효율적으로 사용할 수 있게 된다.
# 기본값 보다 더 낮은 값을 추천하지 않는데, 통계가 부정확해 질 수 있다.
# 만약 innodb_stats_traditional 을 활성화 하면 이 변수 값을 사용한다.
# 만약 innodb_stats_traditional 을 비활성화하면 logarithmic 알고리즘을 사용해 통계를 위한 샘플에 페이지 수를 계산하며
# 정확한 수는 테이블의 크기에 따라 바뀔 수 있다. 
# 만약 persistent_staticts를 활성화하면 innodb_stats_persistent_sample_pages 시스템 변수가 대신 적용된다.
# persistent_statistics 는 innodb_stats_persistent 시스템 변수와함께 활성화 된다.
# 기본값: 8
# 범위: 1 ~ 2^64-1
# Dynamic 설정을 할수 있다. SET GLOBAL innodb_stats_transient_sample_pages = 8
innodb_stats_transient_sample_pages = 8

# InnoDB buffer pool 에서 dirty pages 를 플러쉬하는 비율을 다이나믹하게 조절할지 말지 결정.
# 버스트 I/O 활동을 피하기위한 목적으로 다이나믹하게 조절하는 것.
# 기본값: ON
# Dynamic 설정을 할수 있다. SET GLOBAL innodb_adaptive_flushing = ON
innodb_adaptive_flushing = ON

# buffer pool 에서 디스크로 쓰여지지 않은 페이지(dirty page)의 퍼센티지.
# dirty pages 의 퍼센티지를 넘지 않기 위해서 InnoDB는 buffer pool을 데이터 플러쉬(flush)를 시도합니다.
# 말 그래도 innodb 에서 dirty pages 의 퍼센티지.
# 기본값: 90
# 범위: 0 ~ 99.999
# Dynamic 설정을 할수 있다. SET GLOBAL innodb_max_dirty_pages_pct = 75
innodb_max_dirty_pages_pct = 75

# 성능테스트에 기반해, InnoDB adaptive hash index 는 대부분 read-only 워크로드에서 성능에 도움을 주지만,
# DROP TABLE, TRUNCATE TABLE, ALTER TABLE, DROP INDEX 연산과 같은 다른 환경에서는 성능을 떨어트린다.
# 기본값: OFF
# Dynamic 설정을 할수 있다. SET GLOBAL innodb_adaptive_hash_index = OFF
innodb_adaptive_hash_index = OFF

# 특정 조건에 대해서 경고보다 에러를 리턴할지를 결정. strict SQL mode 와 유사합니다.
# 기본값: OFF
# Dynamic 설정을 할수 있다. SET GLOBAL innodb_strict_mode = ON
innodb_strict_mode = ON

# insert buffer 로부터 데이터를 머지(merge)하거나 buffer pool로부터 페이지를 플러쉬(flush)와 같은
# InnoDB 백그라운드 태스크에 의해서 실행될때에 I/O 활성에 상계치(An upper limit) 설정.
# 기본값: 200
# 범위: 100 ~ 2**64-1
# Dynamic 설정을 할수 있다. SET GLOBAL innodb_io_capacity = 200
innodb_io_capacity = 200

# InnoDB 테이블에 AUTO_INCREMENT 값을 생성할때 사용된다.
# Galera Cluster 사용하기 위해서, lock mode 는 2가 필요하다.
# 2 는 row-based 리플리케이션과 호환된다.
# 기본값: 1
# 범위: 
#  0: traditional
#  1: consecutive
#  2: interleaved
# Dynamic 설정을 할 수 없다.
innodb_autoinc_lock_mode = 2

# 기본값: 1000
# 범위: 0 ~ 2^32-1
# Dynamic 설정을 할 수 있다. SET GLOBAL innodb_old_blocks_time = 1000
innodb_old_blocks_time = 1000 

##--------------------------------------------------------------------
# InnoDB base
##--------------------------------------------------------------------

# InnoDB 셧다운 모드.
# 0 - InnoDB 는 풀 퍼지와 변경 버퍼 머지를 포함하는 슬로우 셧다운을 실행. 최악의 경우 몇시간의 걸릴만큼 매우 느리게 진행될 수 있다.
# 1 - 기본값, InnoDB 는 Insert 버퍼 머지와 풀 퍼지를 실행하지 않는 Fast 셧다운.
# 2 - InnoDB redo log 플러시하고 마치 크래쉬와 유사하게 cold 셧다운 된다. 결과적으로 Mariadb가 시작될때에 크래쉬 리커버리를 실행한다. 
#     비상사태 경우처럼 극단적으로 빠르게 진행되지만 corruption 리스크가 있다.
# 3 - 활성 트랜잭션은 롤백되지 않지만, 모든 변경 페이지는 데이터 파일에 쓴다. 활성 트랜잭션은 Mariadb 시작시에 백그라운드 쓰레드에 의해서 롤백 된다.
#     MariaDB 시작시에 InnoDB redo log 적용을 수반하지 않는 가장 빠른 옵션이다.
# 기본값: 1
# 범위: 0 ~ 3
# Dynamic 설정할 수 있다. SET GLOBAL innodb_fast_shutdown = 1 
innodb_fast_shutdown = 1

# InnoDB 크래쉬 복구 모드. 기본값은 0 이다.
# 다른 모드들은 오직 복구 목적위한 것이며, 다른 모드가 활성화 되어 있는 동안에는 데이터 변경은 되지 않는다.
# 기본값: 0
# 범위: 0 ~ 6
# Dynamic 변경할 수 없다.
innodb_force_recovery = 0

# InnoDB buffer pool 크기(bytes). 
# 만일 전체 혹은 기본적으로 InnoDB 테이블을 사용하는 데이터베이스 서버일 경우  전체 물리 메모리에 
# 80% 를 설정할 수 있다.
# 기본값: 134217728 (128MiB)
# Dynamic 설정할 수 있다. Setting InnoDB Buffer Pool Size Dynamically 반드시 참고.
innodb_buffer_pool_size = 134217728

# innodb_file_per_table 이 활성화되지 않았다면, 공유 테이블스페이스에 있는
# 모든 InnoDB 데이터 파일에 대한 디렉토리 패스.
# 기본값: The MariaDB data directory
# Dynamic 설정을 할 수 없다.
innodb_data_home_dir = /opt/dbstorage/InnoDB/ibData

# 개별적인 InnoDB 데이터 파일과 그 크기를 지정.
# 기본값: ibdata1:12M:autoextend
# Dynamic 설정을 할 수 없다.
innodb_data_file_path = ib_data:100M:autoextend

# InnoDB 임시 테이블의 데이터 저장을 어디에 할지 경로 지정.
# 경로를 지정하지 않으면 innodb_data_home_dir 에 생성된다.
# 범위: path:size[:autoextend][:max:size][:autoshrink]
innodb_temp_data_file_path = ibtmp1:50M;ibtmp2:50M:autoextend:max:128M

# 만약 ON 으로 지정하면, 새로 생성되는 InnoDB 테이블은 그들만의 InnoDB file-per-table 테이블스페이스를 생성한다.
# 만약 OFF 로 지정하면, 새로 생성되는 InnoDB 테이블은 InnoDB 시스템 테이블스페이스에 생성된다.
# Page 압축은 file-per-table 테이블스페이스에서만 사용가능하다.
# 주의해야할 것은 이 값은 테이블 복사를 필요로 하는 ALTER TABLE 로 테이블을 재생성할때에도 사용된다.
# 확장자는 .ibd
# 기본값은 0
# Dynamic 설정을 할수 있다. SET GLOBAL innodb_file_per_table = ON
innodb_file_per_table = ON

# shared 테이블스페이스 파일이 꽉차게 되었을때에 자동확장 shared 테이블스페이스를 증가시킬 크기(MB)
# 만약 innodb_file_per_table 이 1 이면, per-table 테이블 스페이스 파일에 적용되지 않으며 그들만의 방법으로 자동확장 된다.
# 기본값: 64 MB
# 범위: 1 ~ 1000
# Dynamic 설정할 수 있다. SET GLOBAL innodb_autoextend_increment = 128
innodb_autoextend_increment = 128

# InnoDB redo log 파일 경로. 만일 지정하지 않으면 ib_logfile0 이름지어진 파일이 innodb_log_files_in_group 지정한 수만큼 생성되며
# innodb_log_file_size 크기를 가지는 파일이 data 디렉토리에 생성된다.
# 역: innodb_log_files_in_group 은 MariaDB 10.6 에서 제거 됐다.
# Dynamic 설정할 수 없다.
innodb_log_group_home_dir = /opt/dbstorage/InnoDB/redoLogs

# log 그룹에 각 InnoDB redo log 파일의 크기(bytes)
# 모든 InnoDB redo log 파일의 총합은 512GB 를 넘을 수 없다. 
# 큰 값은 checkpoint 플러싱이 적게 발생해 Disk I/O 가 적게 발생되지만 크래쉬 이후에 리커버리가 오래걸릴 수 있다.
# checkpoint 플러시를 줄이기 위해서 큰 값을 설정해도, innodb_buffer_pool_size 보다 크게 값조차, 안전하다.
# Mariadb 10.9 이후부터 Dynamic 설정할 수 있지만, 로그 크기 변경은 SET GLOBAL 명령문을 실행하는 연결을 killing 함으로써 중단될 수 있다.
# 기본값: 100663296 bytes (96MB)
# Dynamic 설정할 수 있다. SET GLOBAL innodb_log_file_size = 100663296
innodb_log_file_size = 100663296

# InnoDB redo log 파일을 디스크로 쓰기 위해 사용하는 버퍼 크기(bytes)
# 이 값을 증가시면, 큰 트랜잭션이 커밋되기 전에 disk I/O 필요 없이 실행될 수 있다.
# 기본값: 16777216 (bytes) (16MB)
# 범위: 262144 ~ 2147479552
# Dynamic 설정할 수 없다.
innodb_log_buffer_size = 16777216

# 데이터 파일을 쓰기전에 InnoDB 는 데이터를 doublewrite buffer 에 저장함으로써 fault tolerance 를 개선한다.
# 기본값: ON
# 범위: OFF, ON, fast
# Dynamci 설정할 수 있다. SET GLOBAL innodb_doublewrite = ON
innodb_doublewrite = ON

# ib_logfile0 에 대한 파일 시스템 캐쉬를 활성할지 여부.
# MariaDB 는 리눅스에서 기본적으로 InnoDB write-ahead 로그 파일(ib_logfile0) 에 파일 시스템 캐쉬를 비활성화 한다.
# 기본값: OFF
# Dynamic 설정할 수 있다. SET GLOBAL innodb_log_file_buffering = OFF
innodb_log_file_buffering = OFF

# 데이터 파일에 대한 파일 시스템 캐쉬를 활성화할지 말지 결정.
# innodb_flush_method 가 fsync, littlesync, nosync 혹은 (Windows 특화) normal 을 지정한다면 이 값을 ON 으로 해야 한다.
# 기본값: OFF
# Dynamic 변경할 수 있다. SET GLOBAL innodb_data_file_buffering = OFF
innodb_data_file_buffering = OFF

# 각각의 ib_logfile0에 대한 쓰기가 캐시를 사용하지 않고 직접 기록되는지 여부를 지정합니다 (O_SYNC 또는 O_DSYNC 방식처럼)
# 기본값: OFF
# Dynamic 설정할 수 있다. SET GLOBAL innodb_log_file_write_through = OFF
innodb_log_file_write_through = OFF

# 임시 테이블스페이스를 포함한 InnoDB 데이터 파일을 직접 쓸지 여부.
# 기본값: OFF
# Dynamic 설정할 수 있다. SET GLOBAL innodb_data_file_write_through = OFF
innodb_data_file_write_through = OFF

# InnoDB 가 undo log 에 대한 별도의 테이블스페이스를 생성하는데 사용할 디렉토리 경로.
# 기본값은 NULL 인데, undo 테이블스페이스는 datadir 에 정의한 디렉토리에 생성된다.
# innodb_undo_logs 와 innodb_undo_tablespaces 를 함께 사용해라.
# 역: innodb_undo_logs 는 MariaDB 10.6.0 에서 제거 됐다.
# 기본값: NULL
# Dynamic 설정할 수 없다.
innodb_undo_directory = /opt/dbstorage/InnoDB/undoLogs

# undo log 를 쪼개는데 사용할 테이블스페이스 파일의 개수.
# 0 은 모든 undo log 가 시스템 테이블스페이스에 포함되며, innodb_undo_tablespaces 보다 하나 더 많은 undo 테이블스페이스를 포함한다.
# undo log 가 크게 커지게 되면, 테이블스페이스 크기를 줄이기 위해서 여러개의 테이블스페이스로 쪼갠다.
# MariaDB 10.11.1 까지는 InnoDB 초기화 전에 지정되어야하며, 그렇게 하지 않으면 MariaDB 시작시 
# "InnoDB did not find the expected number of undo tablespaces" 에러 메시지를 내며 실패한다.
# 파일은 innodb_undo_directory 에 지정한 디렉토리에 생성되며, 파일명은 undoN, N 은 정수다.
# 기본값: 3
# 범위: 0, 2 ~ 95
# Dynamic 설정할 수 없다.
innodb_undo_tablespaces = 3

# 활성화되면, innodb_max_undo_log_size 보다 큰 innodb_undo_tablespaces 를 truncat 대상으로 표시한다.
# 이 설정을 활성화하면 무거운 쓰기 작업 중에 중단이 발생할 수 있다.
# 기본값: OFF
# Dynamic 설정할 수 있다. SET GLOBAL innodb_undo_log_truncate = OFF
innodb_undo_log_truncate = OFF

# innodb_undo_log_truncate 이 설정되었을때, undo 테이블스페이스가 이 값보다 커지면 truncat 을 위해 표시한다.
# 기본값: 10485760
# 범위: 10485760 ~ 18446744073709551615
# Dynamic 설정할 수 있다. SET GLOBAL innodb_max_undo_log_size = 10485760
innodb_max_undo_log_size = 10485760

# 임시 non-tablespace 파일을위해 지정하는 대체 위치.
# 만약 지정하지 않으면 파일들은 MariaDB 에 tmpdir 위치에 생성된다.
# 기본값: Empty
# Dynamic 설정할 수 있다. SET GLOBAL innodb_tmpdir = /opt/dbstorage/InnoDB/tmp
innodb_tmpdir = /opt/dbstorage/InnoDB/tmp

# InnoDB 트랜잭션이 "ERROR 1205 (HY000): Lock wait timeout exceeded; try restarting transaction" 에러를 내고
# 포기하기전에 InnoDB 레코드 락(혹은 테이블 락)을 기다리는 시간.
# 이것이 발생하면 명령문(트랜잭션이 아닌)은 롤백된다. 전체 트랜잭션은 innodb_rollback_on_timeout 옵션을 사용한다면
# 롤백 될 수 있다. 
# 기본값: 50
# 범위: 0 ~ 100000000
# Dynamic 설정할 수 있다. SET GLOBAL innodb_lock_wait_timeout = 50
innodb_lock_wait_timeout = 50

# InnoDB 는 기본적으로 트랜잭션이 타임아웃되면 마지막 명령문만 롤백된다.
# 만일 이 값이 활성되면, 트랜잭션이 타임아웃되면 InnoDB 는 중단되고 전체 트랜잭션은 롤백 된다.
# 기본값: 0
# Dynamic 설정할 수 없다.
innodb_rollback_on_timeout = 0

# InnoDB에서 트랜잭션이 커밋될때마다 로그를 디스크에 쓸건지 말지 결정.
# 1 - 기본값. log buffer 는 InnoDB redo log 에 쓰여지고 각 트랜잭션 이후에 디스크로 플러시 된다. 완전한 ACID 준수를 위해서 필요하다.
# 0 - 커밋시 아무것도 안한다. 대신 log buffer 는 1초마다 InnoDB redo log 에 기록되고 플러시 된다. 최고의 성능을 제공하지만, 서버가 크래쉬 되면
#     마지막 몇초간의 트랜잭션은 손실될 수 있다.
# 2 - log buffer 는 각 커밋 이후에 InnoDB redo log 에 쓰여지지만, innodb_flush_log_at_timeout 설정된 시간마다 플러시 된다. 성능은 약간 낫지만,
#     서버가 크래쉬 되면 마지막 몇초간의 트랜잭션은 손실될 수 있다.
# 기본값: 1
# 범위: 0, 1, 2
# Dynamic 설정을 할수 있다. SET GLOBAL innodb_flush_log_at_trx_commit = 1
innodb_flush_log_at_trx_commit = 1

# 쓰레드가 서스펜드되기전에 InnoDB 뮤텍스가 해제되기어질때까지 쓰레드가 기다리는 시간.
# 기본값: 30
# 범위: 0 ~ 4294967295
# Dynamic 설정을 할수 있다. SET GLOBAL innodb_sync_spin_loops = 20
innodb_sync_spin_loops = 20

# autocommit이 0으로 설정되어 있을 경우(기본값은 1), innodb_table_locks를 1로 설정하면(기본값), 
# InnoDB는 LOCK TABLE 명령 시 내부적으로 테이블을 잠근다.
# 기본값: ON
# Dynamic 설정할 수 있다. SET GLOBAL innodb_table_locks = 1
innodb_table_locks = 1

# purge 연산이 바쁜 서버에서 지연될때에 이값을 설정하면 도움이 될 수 있다.
# 기본값은 0으로, 지연이 없으며, 시스템에 부하가 걸릴 경우 각 INSERT, UPDATE, DELETE 에 대한 시간 지연을 계산하는 데 사용된다.
# InnoDB 는 UPDATE 와 DELETE 문로 인해 delete-marked index 레코드를 가지는 트랜잭션 목록을 유지한다.
# 기본값: 0 millisconds 
# 범위: 0 ~ 4294967295
# Dynamic 설정을 할수 있다. SET GLOBAL innodb_max_purge_lag = 10000
innodb_max_purge_lag = 0

##--------------------------------------------------------------------
# mysqldump
##--------------------------------------------------------------------
[mysqldump]

# 테이블을 덤프할때에는 MySQL 서버는 메모리 버퍼링을 사용합니다. 하지만 큰 테이블을 덤프할때에 메모리 버퍼링을 사용하면 문제가 될 수 있습니다.
# 이 메모리 버퍼링을 끄기 위해서 다음과 같이 합니다.
# 기본은 메모리 버퍼링 사용하기 입니다.
quick

# 서버와 클라이언트간 통신에 사용할 최대 버퍼 사이즈.
# 기본값: 67108864 bytes
# 범위: 1024 ~ 1073741824
max_allowed_packet = 1073741824

##--------------------------------------------------------------------
# mysql console
##--------------------------------------------------------------------
[mysql]

# mysql 에서 사용할 기본 언어셋 지정.
default-character-set = utf8

# MySQL 에서도 리눅스의 명령해완성기능, 즉 탭을 누르면 명령형이 완성는 기능, 을 지원합니다. 명령행뿐만 아니라 칼럼명, 테이블 이름, 데이터베이스명등도 완성시켜줍니다.
# 문제는 이러한 기능을 하기위해서는 각종 정보를 모두 읽고 분석해 메모리에 적해놔야 합니다.
# 필요한 기능하긴 하지만 대용량을 운영할 경우 사용하지 않는게 좋습니다.
no-auto-rehash

# MySQL 에서 경고(Warning)가 발생하면 표시는 하지 않지만 결과값으로 있다없다정도만 보여주고, "SHOW WARNINGS;"를 이용해서 봐야 합니다.
# 그러지 말고 경고가 발생하면 그냥 표시하도록 설정을 해줍니다.
show-warnings

# MySQL 클라이언트의 프롬프트를 바꿉니다.
prompt=\u@\h:\d\_\R:\m:\\s>

# paging 기능을 지원합니다.
pager="less -n -i -F -X -E"

##--------------------------------------------------------------------
# mysql client
##--------------------------------------------------------------------
[client]
socket  = /opt/mariadb/run/mariadb.sock
port = 3306
